# Placeholders only. Copy to secrets/shorts.env (git-ignored) or export in your shell.
# Never commit real values. Booleans: true/false.

# --- mode -------------------------------------------------------------------------------------
# prod forbids mock providers and SQLite
APP_ENV=dev
# nothing is uploaded while true
DRY_RUN=true
# false: real uploads are always private
AUTO_PUBLISH=false
# nvidia | mock (mock only for local tests)
PROVIDER_MODE=nvidia
# youtube | fixture
TREND_SOURCE=youtube
TREND_FIXTURE_FILE=examples/trends_fixture.json

# --- state & storage --------------------------------------------------------------------------
# local dev only; prod: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./var/shorts.db
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
S3_ENDPOINT_URL=https://s3.example.invalid
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>

# --- NVIDIA -----------------------------------------------------------------------------------
NVIDIA_API_KEY=<nvapi-...>
NIM_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_VISION_MODEL=nvidia/cosmos-reason2-8b
# No default on purpose: the hosted cosmos3-nano URL is not documented (docs/capabilities.md §1.3).
NIM_VIDEO_URL=
NIM_VIDEO_ASYNC_STATUS_URL=
NIM_VIDEO_RESOLUTION=720_9_16
BUDGET_TEXT_REQUESTS_PER_DAY=40
BUDGET_VISION_REQUESTS_PER_DAY=10
# generation is disabled until you set a positive number
BUDGET_VIDEO_REQUESTS_PER_DAY=0
BUDGET_VIDEO_REQUESTS_PER_JOB=6

# --- YouTube ----------------------------------------------------------------------------------
YOUTUBE_API_KEY=<google-api-key-for-data-api>
YOUTUBE_CLIENT_ID=<oauth-desktop-client-id>.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=<oauth-client-secret>
# Either the token itself, or YOUTUBE_TOKEN_FILE written by `shorts auth init --out secrets/youtube-token.json`
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_FILE=secrets/youtube-token.json
YOUTUBE_CHANNEL_ID=UC<your-channel-id>
UPLOAD_URI_KEY=<openssl rand -base64 32>

# --- publication consent (used with AUTO_PUBLISH=true) -----------------------------------------
PUBLISH_CONSENT_CHANNEL_ID=UC<your-channel-id>
# private | unlisted | public
PUBLISH_PRIVACY=private
# must be set explicitly to true or false before any real upload
PUBLISH_MADE_FOR_KIDS=
# HH:MM -> scheduled publishAt (public only)
PUBLISH_TIME_UTC=
PUBLISH_DAILY_LIMIT=1

# --- discovery & content ----------------------------------------------------------------------
TREND_KEYWORDS=ai generated,ai video
TREND_CHANNEL_ALLOWLIST=
TREND_REGION=US
TREND_LANGUAGE=en
TREND_WINDOW_HOURS=72
TREND_MAX_RESULTS=25
CONTENT_LANGUAGE=ru
TARGET_MIN_S=15
TARGET_MAX_S=30
TTS_PROVIDER=none
# none | local | s3
REFERENCE_SOURCE=none
